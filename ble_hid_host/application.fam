# External app. Needs firmware built by ../build.sh: full BLE stack plus the
# ST aci_*/hci_* command API exported to apps.
App(
    appid="ble_hid_host",
    name="BLE HID Host",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="ble_hid_host_app",
    requires=["gui", "storage"],
    stack_size=4 * 1024,
    fap_category="Bluetooth",
    fap_icon="icon.png",
    fap_version="1.0",
    fap_description="Connect a BLE keyboard or mouse and watch its input reports",
    fap_author="andydixon",
    fap_weburl="https://github.com/andydixon/flipper-bluepp",
)
