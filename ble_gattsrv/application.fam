# Needs firmware from ../build.sh (full BLE stack + exported peripheral API).
App(
    appid="ble_gattsrv",
    name="BLE GATT Server",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="ble_gattsrv_app",
    requires=["gui", "bt"],
    stack_size=2 * 1024,
    fap_category="Bluetooth",
    fap_icon="icon.png",
    fap_version="1.0",
    fap_description="Advertise a connectable serial GATT peripheral and echo received data",
    fap_author="andydixon",
    fap_weburl="https://github.com/andydixon/flipper-bt-inspector",
)
